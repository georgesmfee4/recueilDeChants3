{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Le recueil est un contenu figé et typé : on veut que le compilateur
    // refuse tout accès hasardeux (index inexistant, valeur potentiellement nulle).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    // "@/..." pointe toujours sur src/ : plus de "../../../" dans les imports.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "design_handoff_recueil_chants_iii"]
}
