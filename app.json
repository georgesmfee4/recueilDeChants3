{
  "expo": {
    "name": "Recueil de Chants III",
    "slug": "recueil-de-chants-iii",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "recueil",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBFAF7",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.recueildechants.iii"
    },
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "android": {
      "package": "app.recueildechants.iii",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBFAF7"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Newsreader-Regular.ttf",
            "./assets/fonts/Newsreader-Italic.ttf",
            "./assets/fonts/Newsreader-Medium.ttf",
            "./assets/fonts/Newsreader-SemiBold.ttf",
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf"
          ]
        }
      ],
      "expo-updates",
      "expo-navigation-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4E2A84",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#4E2A84",
            "image": "./assets/splash.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/90a44499-bb6b-4482-ac47-7355f47aa46b"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "90a44499-bb6b-4482-ac47-7355f47aa46b"
      }
    },
    "owner": "georgesmfee"
  }
}
